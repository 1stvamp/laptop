// Throwaway VM for trying COSMIC.
host "vm-cosmic" {
    system "x86_64-linux"
    nixpkgs release="26.05"

    os {
        state-version "26.05"
        timezone "Europe/London"
        locale "en_GB.UTF-8"
        boot-loader "systemd-boot"
        experimental-feature "nix-command"
        experimental-feature "flakes"
    }

    base {
        keymap "gb"
        allow-unfree
        networkmanager
        pipewire
    }

    desktop {
        cosmic
        autologin "wes"
    }

    vm-guest {
        memory-mb 8192
        cores 4
        disk-mb 16384
        root-label "nixos" fs-type="ext4"
        guest-agent
        spice
        initial-password "wes" password="wes"
    }

    user "wes" {
        description "Wes"
        group "wheel"
        group "networkmanager"
        group "video"
    }

    // COSMIC ships its own apps; nothing extra needed.
}
