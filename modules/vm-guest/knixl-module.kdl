// Every setting goes under virtualisation.vmVariant, so it only applies to the
// build-vm output and is inert on real hardware.

module name="vm-guest" version="3.0.0" {
    summary "build-vm sizing, guest agents, a login and a shared folder, for testing a host in QEMU."
    claims-node "vm-guest"

    schema {
        child "memory-mb" repeated=#true doc="RAM for the build-vm variant. At most one." {
            arg "mb" type="int" required=#true
        }
        child "cores" repeated=#true doc="vCPUs for the build-vm variant. At most one." {
            arg "n" type="int" required=#true
        }
        child "disk-mb" repeated=#true doc="Disk size for the build-vm variant. At most one." {
            arg "mb" type="int" required=#true
        }
        child "initial-password" repeated=#true \
            doc="Plaintext password for a user in the VM, for getting past an idle lock screen. It lands in the store and in git." {
            arg "user" type="string" required=#true
            prop "password" type="string" required=#true
        }
        child "autologin" repeated=#true doc="Log this user in at the display manager in the VM. At most one." {
            arg "user" type="string" required=#true
        }
        child "share" repeated=#true \
            doc="A host directory shown at target copy-on-write: a read-only 9p mount at /mnt/shares/<tag> with an overlay on the VM's disk, so the VM never writes to the host. source is expanded by the run script's shell, so it can name an environment variable." {
            arg "tag" type="string" required=#true
            prop "source" type="string" required=#true
            prop "target" type="string" required=#true
        }
        child "guest-agent" type="bool" doc="qemu-guest-agent, for graceful shutdown and host integration."
        child "spice" type="bool" doc="spice-vdagent, for clipboard sharing and dynamic display resize."
    }

    emit {
        for-each "m" in "memory-mb" {
            set "virtualisation.vmVariant.virtualisation.memorySize" (scalar)"{m.mb}"
        }
        for-each "c" in "cores" {
            set "virtualisation.vmVariant.virtualisation.cores" (scalar)"{c.n}"
        }
        for-each "d" in "disk-mb" {
            set "virtualisation.vmVariant.virtualisation.diskSize" (scalar)"{d.mb}"
        }
        for-each "p" in "initial-password" {
            set "virtualisation.vmVariant.users.users.{p.user}.initialPassword" "{p.password}"
        }
        for-each "a" in "autologin" {
            set "virtualisation.vmVariant.services.displayManager.autoLogin.enable" #true
            set "virtualisation.vmVariant.services.displayManager.autoLogin.user" "{a.user}"
        }
        for-each "s" in "share" {
            set "virtualisation.vmVariant.virtualisation.sharedDirectories.{s.tag}.source" "{s.source}"
            set "virtualisation.vmVariant.virtualisation.sharedDirectories.{s.tag}.target" "/mnt/shares/{s.tag}"
            set "virtualisation.vmVariant.virtualisation.fileSystems.\"/mnt/shares/{s.tag}\".options" (list)"ro"
            // Under virtualisation.fileSystems: qemu-vm replaces fileSystems wholesale.
            set "virtualisation.vmVariant.virtualisation.fileSystems.\"{s.target}\".overlay.lowerdir" (list)"/mnt/shares/{s.tag}"
            set "virtualisation.vmVariant.virtualisation.fileSystems.\"{s.target}\".overlay.upperdir" "/var/lib/vm-shares/{s.tag}/upper"
            set "virtualisation.vmVariant.virtualisation.fileSystems.\"{s.target}\".overlay.workdir" "/var/lib/vm-shares/{s.tag}/work"
            set "virtualisation.vmVariant.virtualisation.fileSystems.\"{s.target}\".options" (list)"x-systemd.requires=vm-share-dirs-{s.tag}.service"
            // The merged root takes its owner from the upperdir, so give that (and a new
            // mountpoint parent) the share's owner before mounting.
            set "virtualisation.vmVariant.systemd.services.\"vm-share-dirs-{s.tag}\".unitConfig.DefaultDependencies" #false
            set "virtualisation.vmVariant.systemd.services.\"vm-share-dirs-{s.tag}\".unitConfig.RequiresMountsFor" "/mnt/shares/{s.tag}"
            set "virtualisation.vmVariant.systemd.services.\"vm-share-dirs-{s.tag}\".serviceConfig.Type" "oneshot"
            set "virtualisation.vmVariant.systemd.services.\"vm-share-dirs-{s.tag}\".script" (indent-str)#"""
                mkdir -p /var/lib/vm-shares/{s.tag}/upper /var/lib/vm-shares/{s.tag}/work
                chown --reference=/mnt/shares/{s.tag} /var/lib/vm-shares/{s.tag}/upper
                parent="$(dirname "{s.target}")"
                if [ ! -d "$parent" ]; then
                  mkdir -p "$parent"
                  chown --reference=/mnt/shares/{s.tag} "$parent"
                fi
                """#
        }
        when-flag "guest-agent" {
            set "virtualisation.vmVariant.services.qemuGuest.enable" #true
        }
        when-flag "spice" {
            set "virtualisation.vmVariant.services.spice-vdagentd.enable" #true
        }
    }
}
