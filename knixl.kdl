system {
    state-version "26.05"
    formatter "nixfmt-rfc-style"
    input "nixpkgs" url="github:NixOS/nixpkgs"
    input "nixos-hardware" url="github:NixOS/nixos-hardware" {
        follows nixpkgs="nixpkgs"
    }
    input "disko" url="github:nix-community/disko" {
        follows nixpkgs="nixpkgs"
    }
    // Branch refs are refused, so this is the release-26.05 tip by rev.
    input "home-manager" url="github:nix-community/home-manager" \
        rev="a6631107a83ceab5872f298a2ea710859c80c4cb" {
        follows nixpkgs="nixpkgs"
    }
}

// fw13 replaces this set with its own, to add nixos-hardware.
oracle-modules {
    module "disko" input="disko" attr="disko"
    module "home-manager" input="home-manager" attr="home-manager"
}
